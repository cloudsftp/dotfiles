[init]
	defaultBranch = latest

[push]
	autoSetupRemote = true

[user]
	name = Clouds
	email = me@cloudsftp.de

[includeIf "hasconfig:remote.*.url:git@gitlab.itwm.fraunhofer.de:*/**"]
	path = .gitconfig-work

[includeIf "hasconfig:remote.*.url:git@gitlab.cc-asp.fraunhofer.de:*/**"]
	path = .gitconfig-work

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[pull]
	rebase = true
