[init]
	defaultBranch = latest

[push]
	autoSetupRemote = true

[user]
	name = Fabian Weik
	email = fabian.weik@protonmail.com

[includeIf "hasconfig:remote.*.url:git@gitlab.itwm.fraunhofer.de:*/**"]
	path = .gitconfig-work

[includeIf "hasconfig:remote.*.url:git@gitlab.cc-asp.fraunhofer.de:*/**"]
	path = .gitconfig-work

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[mu-repo]
	remote-base-url = git@gitlab.itwm.fraunhofer.de:TV_EMO
